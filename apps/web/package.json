{
  "name": "evalops-evidence-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start:static": "http-server out -p 4173 -c-1",
    "start:pages": "node scripts/serve-pages.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "storybook": "storybook dev -p 6006 --config-dir .storybook",
    "storybook:build": "storybook build --config-dir .storybook --output-dir storybook-static",
    "storybook:build:public": "storybook build --config-dir .storybook-public --output-dir storybook-public-static",
    "storybook:test": "vitest run --project=storybook-light --project=storybook-dark",
    "test:e2e": "playwright test",
    "test:e2e:pages": "node scripts/test-pages-e2e.mjs"
  },
  "dependencies": {
    "@evalops/evidence-ui": "file:../../packages/evidence-ui",
    "geist": "^1.7.2",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3",
    "follow-redirects": "^1.16.2"
  }
}
