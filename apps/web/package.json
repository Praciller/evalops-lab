    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "http-server": "^14.1.1",
